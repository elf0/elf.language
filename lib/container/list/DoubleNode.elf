elf: 0

#{
  next: #
  prev: #
}

Next: node
  node = next

Next[node]
  next = node

Prev: node
  node = prev

Prev[node]
  prev = node

LinkPrev[prev]
  .prev = prev
  prev.next = .

LinkNext[next]
  .next = next
  next.prev = .

Link[prev, next]
  LinkPrev[prev]
  LinkNext[next]

Unlink
  prev.next = next
  next.prev = prev

Reset
  prev = .
  next = .

Alone: is
  return next == .

MoveBuddiesTo[target]
  next.LinkPrev[target.prev]
  prev.LinkNext[target]

MoveBuddiesToFront[target]
  next.LinkPrev[target]
  prev.LinkNext[target.next]

Swap[target]
  next.prev = target
  target.next.prev = .
  Swap[next, target.next]

  prev.next = target
  target.prev.next = .
  Swap[prev, target.prev]

